# Frontend API Gateway URL (Paste your AWS API Gateway endpoint URL here after deployment)
NEXT_PUBLIC_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# Backend OpenAI API Key (Paste your OpenAI API key here)
OPENAI_API_KEY=paste_your_openai_api_key_here

# AWS Region Configuration (Optional)
AWS_REGION=us-east-1

